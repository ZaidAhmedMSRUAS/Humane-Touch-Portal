generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TRUSTEE
  VOLUNTEER
  STUDENT
}

enum ApplicationStatus {
  SUBMITTED
  DOC_VERIFICATION
  TRUSTEE_INTERVIEW
  APPROVED
  REJECTED
}

enum OtpType {
  PHONE_VERIFY
  EMAIL_VERIFY
  FORGOT_PASSWORD
}

model User {
  id                    String                @id @default(cuid())
  fullName              String
  phone                 String
  email                 String?
  passwordHash          String
  role                  UserRole              @default(STUDENT)
  isActive              Boolean               @default(true)
  isPhoneVerified       Boolean               @default(false)
  isEmailVerified       Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  studentApplications   Application[]         @relation("StudentApplications")
  assignedApplications  Application[]         @relation("VolunteerApplications")
  verificationReports   VerificationReport[]

  @@unique([phone, role])
}

model OtpVerification {
  id          String   @id @default(cuid())
  identifier  String   // Phone or Email
  code        String   // 6-digit OTP
  type        OtpType
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([identifier, type])
}

model Application {
  id                         String                @id @default(cuid())
  referenceNumber            String?               @unique
  studentId                  String
  student                    User                  @relation("StudentApplications", fields: [studentId], references: [id])
  
  assignedVolunteerId        String?
  assignedVolunteer          User?                 @relation("VolunteerApplications", fields: [assignedVolunteerId], references: [id])
  
  collegeName                String
  courseName                 String
  currentYearOfStudy         String
  previousScoreMarks         Float
  familyAnnualIncome         Float
  annualTuitionFee           Float
  householdCategory          String
  residentialAddress         String
  personalStatement          String
  status                     ApplicationStatus     @default(SUBMITTED)
  
  docStudentAadhaar          String?
  docParentAadhaar           String?
  docIncomeCaste             String?
  docMarksCards              String?
  docFeeDemandNote           String?
  docDeathDivorceCert        String?
  docOther                   String?

  chequeInFavourOf           String?
  chequeNumber               String?
  
  interviewRemarks           String?
  interviewScore             Int?
  interviewConductedBy       String?
  sanctionedAmount           Float?

  verificationReport         VerificationReport?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
}

model VerificationReport {
  id                         String       @id @default(cuid())
  applicationId              String       @unique
  application                Application  @relation(fields: [applicationId], references: [id])
  volunteerId                String
  volunteer                  User         @relation(fields: [volunteerId], references: [id])
  
  marksCardVerified          Boolean      @default(true)
  incomeCertificateVerified  Boolean      @default(true)
  feeDemandNoteVerified      Boolean      @default(true)
  chequePayeeVerified        String
  volunteerRemarks           String
  isRecommended              Boolean      @default(true)
  createdAt                  DateTime     @default(now())
}
enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model StudentDeletionRequest {
  id                 String                @id @default(cuid())
  studentId          String
  studentName        String
  studentPhone       String
  requestedByPhone   String
  requestedByName    String
  reason             String
  status             DeletionRequestStatus @default(PENDING)
  adminRemarks       String?
  createdAt          DateTime              @default(now())
  resolvedAt         DateTime?
  resolvedBy         String?
}